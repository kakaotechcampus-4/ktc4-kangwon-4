# 서버를 부를 때 앞에 붙이는 주소. 끝에 / 를 붙이지 않는다.
#
# 비워두면 /api 를 쓴다 — 같은 출처로 요청해 vercel.json 의 프록시가 서버로 넘긴다.
# 배포된 화면은 HTTPS 인데 서버가 HTTP 라, 직접 부르면 브라우저가 차단하기 때문이다.
# 그래서 Vercel 에는 이 값을 두지 않는다.
#
# 로컬 개발은 .env.local 을 만들어 아래 중 하나를 넣는다.
#   VITE_API_BASE_URL=http://localhost:8000      로컬 BE. 카카오 로그인까지 확인 가능
#   VITE_API_BASE_URL=http://52.79.222.103       배포 BE. 로그인은 못 보고 나머지만 확인
#
# 여기 적는 값은 빌드 결과에 그대로 들어가 누구나 읽을 수 있다. 비밀을 두지 않는다.
VITE_API_BASE_URL=

# Preview 배포에서 ?mock= 으로 예외 화면을 볼 수 있게 한다.
# Vercel 의 Preview 환경에만 true 로 두고 Production 에는 두지 않는다.
VITE_ENABLE_MOCK_SWITCH=

ENVIRONMENT=prod

DATABASE_URL=mysql+pymysql://root:<MYSQL_ROOT_PASSWORD와_동일한_값>@mysql:3306/closure_agent?charset=utf8mb4
MYSQL_ROOT_PASSWORD=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://ktc4-kangwon-4.vercel.app/login/callback

JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI 필수: 발급받은 Sol / Luna 6 endpoint와 키를 각각 채운다. 실제 키는 커밋하지 않는다.
# 공용 설정은 독립 Review, Info는 같은 Sol에 high, 서류 판독은 xhigh를 사용한다.
CHAT_PROXY_URL=https://mlapi.run/<sol-endpoint-id>/v1
PROXY_TOKEN=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=xhigh
AGENT_INFO_MODEL_PREFIX=INFO_
INFO_MODEL=gpt-6.1-sol
INFO_REASONING_EFFORT=high
AGENT_DOCUMENT_MODEL_PREFIX=INFO_
AGENT_DOCUMENT_REASONING_EFFORT=xhigh

# Supervisor는 별도 Luna 6 endpoint를 사용한다. 키가 없으면 Sol로 자동 전환하지 않는다.
AGENT_SUPERVISOR_MODEL_PREFIX=LUNA6_
LUNA6_CHAT_PROXY_URL=https://mlapi.run/<luna6-endpoint-id>/v1
LUNA6_PROXY_TOKEN=
LUNA6_MODEL=gpt-6-luna
LUNA6_REASONING_EFFORT=high

# 기존 실행 상한. 재시도도 호출 수에 포함하며 회원별 하루 한도와는 별개다.
AGENT_MAX_LLM_CALLS_PER_RUN=40
AGENT_RUN_DEADLINE_SECONDS=420
AGENT_LLM_TIMEOUT_SECONDS=180
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_RETRY_BACKOFF_SECONDS=0.5
AGENT_LLM_STREAM=true
AGENT_LLM_MAX_COMPLETION_TOKENS=16000
AGENT_LLM_MAX_RESPONSE_BYTES=8388608

# Dockerfile의 OCR 언어파일과 compose의 서류 보존 볼륨 경로를 유지한다.
AGENT_OCR_TESSDATA_DIR=/opt/reborn/tessdata
AGENT_DOCUMENT_DIR=/data/documents

# 선택: 양쪽 키가 있을 때만 원문 없는 사용량·상태 메타데이터를 전송한다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─────────────────────────────────────────────────────────────
# .env.example
# 이 파일을 복사해서 .env로 만들고, 실제 키 값을 채워넣으세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# 1. LLM / Foundation Model (기본은 mlapi.run 프록시 경유, OpenAI 직접 호출 아님)
# 공용 Sol 설정은 지원금 Agent·독립 Review가 사용합니다.
# Info는 Sol, Supervisor는 아래 AGENT_SUPERVISOR_MODEL_PREFIX로 선택한 Luna 6를 씁니다.
PROXY_TOKEN=
CHAT_PROXY_URL=https://mlapi.run/<sol-endpoint-id>/v1
OPENAI_MODEL=gpt-6.1-sol
# Elice Chat Completions의 최대 추론 설정. 절차조회 등 LLM을 쓰지 않는 Tool에는 적용되지 않습니다.
OPENAI_REASONING_EFFORT=xhigh
# 추론과 최종 답변을 합친 토큰 한도입니다. 비우면 provider 기본값을 사용합니다.
# xhigh에서 추론만으로 한도를 소진해 빈 답변이 나오면 이 값을 함께 조정하세요.
AGENT_LLM_MAX_COMPLETION_TOKENS=16000
# Elice의 비스트리밍 응답 한도(6000토큰)를 넘기려면 true로 설정합니다.
# 조각을 모두 받은 뒤 기존 JSON 검증을 수행하며, FE 스트리밍 설정은 아닙니다.
AGENT_LLM_STREAM=true
# 호출 하나에 허용하는 시간입니다. 전체 실행 상한(AGENT_RUN_DEADLINE_SECONDS)보다
# 작게 두세요 — 같거나 크면 호출 한 번이 전체 예산을 통째로 쓸 수 있습니다.
# 2026-10-01 실측: 성공한 Info 호출이 최대 102초였고 제공자가 503을 돌려줄 때는
# 120초를 쓴다. 150초는 성공 호출 최대치와 너무 가까워 180초로 둔다.
AGENT_LLM_TIMEOUT_SECONDS=180
# retry 시도도 실행당 LLM 호출 예산을 1회로 소모합니다.
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_RETRY_BACKOFF_SECONDS=0.5
# 공식 자료 8개 분석의 스트리밍 프레임이 1MB를 초과해 8MB로 조정합니다. 상한은 유지합니다.
AGENT_LLM_MAX_RESPONSE_BYTES=8388608

# 실행 1건이 쓸 수 있는 LLM 호출 총 횟수입니다. 실제 HTTP 호출을 세고 retry도
# 1회로 칩니다. 적정값은 실측으로 정합니다 — 실행마다 실제 호출 수가 trace의
# `RUN` 이벤트 provider_calls에 남습니다.
AGENT_MAX_LLM_CALLS_PER_RUN=40
# 실행 1건 전체의 시간 상한(초)입니다. 넘기면 RUN_DEADLINE_EXCEEDED로 안전 종료합니다.
# 2026-10-01 실측: Info 제공자가 503을 돌려주는 데 120초가 걸린다. 503을 두 번 맞고
# 세 번째에 성공하는 경로가 120+120+105초이고 Supervisor·Review가 16초를 더 쓴다.
# 300초로는 503 한 번도 못 견디고 SAFE_FAILURE로 끝나므로 420초로 둔다.
AGENT_RUN_DEADLINE_SECONDS=420

# SUPERVISOR_*는 비교 기준 Sol 설정입니다. 실제 선택은 AGENT_SUPERVISOR_MODEL_PREFIX를 따릅니다.
# 비워 두면 공용 설정을 씁니다. 독립 Review는 별도 호출로 공용 Sol을 사용합니다.
SUPERVISOR_CHAT_PROXY_URL=https://mlapi.run/<sol-endpoint-id>/v1
SUPERVISOR_PROXY_TOKEN=
SUPERVISOR_MODEL=gpt-6.1-sol
# 비워 두면 OPENAI_REASONING_EFFORT를 사용합니다. none은 추론을 끄는 명시적 값입니다.
# Supervisor에만 적용되며 Info·지원금·Review의 설정은 바꾸지 않습니다.
SUPERVISOR_REASONING_EFFORT=xhigh

# Info도 Sol을 사용합니다 — 기존 Luna 5.6 endpoint는 Info 요청에서 약 120초 뒤 HTTP 503을
# 자주 반환해, 최초 판단 12회 중 5회가 Info 단계에서 안전 실패했습니다.
# Supervisor와 같은 Sol endpoint·키를 채우세요. 비우면 공용 Sol을 사용합니다.
INFO_CHAT_PROXY_URL=https://mlapi.run/<sol-endpoint-id>/v1
INFO_PROXY_TOKEN=
INFO_MODEL=gpt-6.1-sol
INFO_REASONING_EFFORT=high

# Elice serverless 모델별 페이지에서 발급받은 endpoint와 API 키를 사용하세요.
# Luna endpoint에서 MODEL만 Sol로 바꾸지 말고 /v1/models의 지원 목록을 확인합니다.
# Luna도 해당 endpoint와 gpt-5.6-luna를 지정하면 같은 effort 설정을 쓸 수 있습니다.
# Elice Chat Completions 지원값: none / low / medium / high / xhigh.
# max는 Responses API 전용이므로 현재 client에서는 사용하지 않습니다.
# https://elice.io/en/ax/model-library/b16032a4-84a8-41b4-831f-0ca7be633089
# effort를 높이면 지연·토큰 사용이 늘 수 있습니다. 실행 시간과 실패율을 함께 비교하고
# AGENT_LLM_TIMEOUT_SECONDS 및 AGENT_RUN_DEADLINE_SECONDS는 실측 뒤 조정하세요.

# Luna·Sol 비교 테스트용입니다. 실제 서비스의 SUPERVISOR_* 설정은 그대로 둡니다.
# 테스트에서 LLMConfig.from_env(env_prefix="LUNA_")로 읽습니다.
# Sol은 SUPERVISOR_*로 읽으며, 평가의 Review 설정은 CLI의 --review-prefix를 따릅니다.
LUNA_CHAT_PROXY_URL=https://mlapi.run/<luna-endpoint-id>/v1
LUNA_PROXY_TOKEN=
LUNA_MODEL=gpt-5.6-luna
LUNA_REASONING_EFFORT=xhigh

# 2. 절차·지원 자료
# Agent는 요청 처리 중 절차·지원 자료를 인터넷·DB·파일에서 직접 수집하지 않습니다. 호출자가 사람이 검수한
# 절차 store와 지원 catalog를 build_runtime에 주입합니다 —
# docs/agent/README.md의 실행 경계 참고. 수집·갱신 도구는 저장소에
# 포함하지 않으므로 검색·공고 API 키도 여기에 두지 않습니다.

# 4. 인프라 — DB는 MySQL + SQLAlchemy + pymysql (2026-09 BE 확정, backend/requirements.txt 참고)
# 루트 docker-compose.yml은 DB만 실행합니다: docker compose up -d db
MYSQL_ROOT_PASSWORD=devpassword
# 로컬 Python backend가 위 DB에 접속할 때의 예시 형식
# DATABASE_URL=mysql+pymysql://root:devpassword@localhost:3306/closure_agent
DATABASE_URL=

# 5. 인증 — 카카오 OAuth + 자체 발급 JWT (pyjwt, 2026-09 BE 확정)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback
JWT_SECRET_KEY=
# 토큰 수명. backend/app/common/config.py에서 읽습니다.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 6. Observability — Langfuse
# 두 키가 모두 채워져 있을 때만 전송이 켜집니다. 비워 두면 아무 데도 보내지 않습니다.
# 보내는 값은 메타데이터(구성요소·상태·지연시간·시도 횟수·모델명·토큰 수)뿐이고
# prompt 원문·evidence·사용자 입력은 보내지 않습니다.
# Langfuse에서 RUN → 구성요소 → LLM generation 순서로 실제 호출을 확인합니다.
# 모델·effort·입출력/캐시/추론 토큰·HTTP 실패/재시도를 기록합니다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Cloud는 https://cloud.langfuse.com, 셀프호스팅이면 그 주소를 씁니다.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 원화 추정 집계(모델 호출 없음, 출력 파일은 새 경로):
# PYTHONPATH=backend python backend/scripts/monitor_agent.py --hours 24 --output eval-runs/monitoring-new.json

# 공식 원문 자동 수집·RAG는 Agent MVP 범위에 포함하지 않습니다.

# Agent 모델 비교 — 엘리스 OpenAI 호환 endpoint만 사용합니다.
# INFO_는 Sol을 유지합니다. LUNA_ / LUNA6_ / HAIKU_ / GEMINI_를 별도로 검증할 수 있습니다.
AGENT_INFO_MODEL_PREFIX=INFO_
# 세 값(URL·키·모델명)이 모두 비면 비교에서 제외합니다. 모델명은 endpoint의 /v1/models를 따릅니다.
# 예: HAIKU_CHAT_PROXY_URL=https://mlapi.run/<발급받은-endpoint-id>/v1
# 추천 후보: Claude Haiku 5.5 / Gemini 3.1 Flash-Lite. 엘리스 제공 여부·실제 ID를 먼저 확인하세요.
HAIKU_CHAT_PROXY_URL=https://mlapi.run/e488b98a-60f2-4db1-9931-49ba1a217dc4/v1
HAIKU_PROXY_TOKEN=
HAIKU_MODEL=claude-haiku-5-5
# 비우면 reasoning_effort를 전송하지 않습니다. 공용 xhigh를 상속하지 않습니다.
HAIKU_REASONING_EFFORT=high
GEMINI_CHAT_PROXY_URL=https://mlapi.run/d3a4d823-8dd9-40a8-aca0-cc4ed7f88153/v1
GEMINI_PROXY_TOKEN=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_EFFORT=high
# 이전 비교 도구용 USD 설정입니다. 이번 평가의 원화 비용은 아래 *_KRW_PER_MILLION을 사용합니다.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
LUNA_INPUT_USD_PER_MILLION=
LUNA_OUTPUT_USD_PER_MILLION=
HAIKU_INPUT_USD_PER_MILLION=
HAIKU_OUTPUT_USD_PER_MILLION=
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
# 비교 실행(기존 agent 경로만 검증, FE·DB 제외):
# PYTHONPATH=backend python backend/scripts/evaluate_agent_roles.py --compare-supervisor --output eval-runs/<새-폴더>
# 기존 절차 입력 검사는 evaluate_planning.py --procedure-snapshot <검수자료.json> --validate-only --output eval-runs/<새-폴더>를 사용합니다.

# Agent 문서 처리: 한국어·영어 로컬 OCR 언어파일 디렉터리. 비우면 ~/.cache/reborn/tessdata
AGENT_OCR_TESSDATA_DIR=

# DocumentTool 추출 모델입니다. OCR 값과 사진 전후는 사용자가 명시적으로 확인합니다.
# 정확도를 우선해 추출과 이미지 판독은 Sol xhigh로 검증합니다. 낮은 설정은 품질 통과 뒤 비교합니다.
AGENT_DOCUMENT_MODEL_PREFIX=INFO_

# 추가 비교 후보: GPT 6 Luna Serverless (기존 LUNA_ 5.6 설정과 분리)
LUNA6_CHAT_PROXY_URL=https://mlapi.run/2b112090-5609-4dde-87fb-161933470bde/v1
LUNA6_PROXY_TOKEN=
LUNA6_MODEL=gpt-6-luna
LUNA6_REASONING_EFFORT=high

# 엘리스 Serverless 단가 (사용자 제공, 2026-11-01): 원/100만 토큰
# PRICE_MODEL과 실제 응답 모델이 일치할 때만 비용을 계산합니다.
OPENAI_PRICE_MODEL=openai/gpt-6.1-sol
OPENAI_INPUT_KRW_PER_MILLION=2835
OPENAI_CACHED_INPUT_KRW_PER_MILLION=141
OPENAI_OUTPUT_KRW_PER_MILLION=14175
LUNA6_PRICE_MODEL=openai/gpt-6-luna
LUNA6_INPUT_KRW_PER_MILLION=141
LUNA6_CACHED_INPUT_KRW_PER_MILLION=14
LUNA6_OUTPUT_KRW_PER_MILLION=708
HAIKU_PRICE_MODEL=anthropic/claude-haiku-5-5
HAIKU_INPUT_KRW_PER_MILLION=141
HAIKU_CACHED_INPUT_KRW_PER_MILLION=14
HAIKU_OUTPUT_KRW_PER_MILLION=708
GEMINI_PRICE_MODEL=google/gemini-3.1-flash-lite
GEMINI_INPUT_KRW_PER_MILLION=354
GEMINI_CACHED_INPUT_KRW_PER_MILLION=35
GEMINI_OUTPUT_KRW_PER_MILLION=2126

# 기존 LangGraph와 모바일 Supervisor 모두 Luna 6 high를 사용합니다.
AGENT_SUPERVISOR_MODEL_PREFIX=LUNA6_

# 독립 Review는 공용 Sol xhigh를 유지합니다.
AGENT_DOCUMENT_REASONING_EFFORT=xhigh

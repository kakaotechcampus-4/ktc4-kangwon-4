# ─────────────────────────────────────────────────────────────
# .env.example
# 이 파일을 복사해서 .env로 만들고, 실제 키 값을 채워넣으세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# 1. LLM / Foundation Model (mlapi.run 프록시 경유, OpenAI 직접 호출 아님)
PROXY_TOKEN=
CHAT_PROXY_URL=https://mlapi.run/<chat-endpoint-id>/v1
EMBEDDING_PROXY_URL=https://mlapi.run/<embedding-endpoint-id>/v1
OPENAI_MODEL=openai/gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# 2. 공용 (정보분석 · 행정 · 철거 · 지원금)
DATA_GO_KR_SERVICE_KEY=

# 3. 지원금
BIZINFO_API_KEY=

# 4. 인프라 — DB는 MySQL + SQLAlchemy + pymysql (2026-09 BE 확정, backend/requirements.txt 참고)
# 로컬 개발: 루트 docker-compose.yml의 db 서비스 사용 시 예시 형식
# DATABASE_URL=mysql+pymysql://root:devpassword@localhost:3306/closure_agent
DATABASE_URL=
# Redis는 BE 확정 스택에 없음 — 현재 사용처 없는 선점 변수
REDIS_URL=

# 5. 인증 — 카카오 OAuth + 자체 발급 JWT (pyjwt, 2026-09 BE 확정)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback
JWT_SECRET_KEY=

# 6. Observability — Langfuse (셀프호스팅, EC2에 함께 배포 예정)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# 6. 크롤링 대상 (선택)
# config.py의 Settings에는 정의되어 있지 않지만, extra="ignore" 설정 덕분에
# 아래처럼 원하는 이름으로 자유롭게 추가해서 코드에서 os.environ으로 읽어 쓸 수 있습니다.
# CRAWL_TARGET_URL=
# CRAWL_TARGET_URLS=https://example.com/notice,https://example.com/board

# ─────────────────────────────────────────────────────────────
# .env.example
# 이 파일을 복사해서 .env로 만들고, 실제 키 값을 채워넣으세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# 1. LLM / Foundation Model (mlapi.run 프록시 경유, OpenAI 직접 호출 아님)
PROXY_TOKEN=
CHAT_PROXY_URL=https://mlapi.run/<chat-endpoint-id>/v1
EMBEDDING_PROXY_URL=https://mlapi.run/<embedding-endpoint-id>/v1
# 2026-09-15 현재 팀 proxy `/models`에서 확인된 ID입니다.
OPENAI_MODEL=openai/gpt-4.1-mini
# reasoning model을 지원하는 endpoint로 바꿀 때만 설정합니다.
OPENAI_REASONING_EFFORT=
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_RETRY_BACKOFF_SECONDS=0.5
# 비정상적으로 큰 provider 응답을 메모리에 계속 적재하지 않도록 제한합니다.
AGENT_LLM_MAX_RESPONSE_BYTES=1000000

# 2. 공용 (정보분석 · 행정 · 철거 · 지원금)
# 같은 키라도 data.go.kr 서비스별 활용신청이 필요합니다. 현재 Agent runtime에는
# NTS/행안부 adapter가 아직 연결되지 않았습니다. 15081808(NTS) 접근과
# 15154921(휴게음식점)·15154916(일반음식점) 실호출은 확인했습니다.
DATA_GO_KR_SERVICE_KEY=
# 법령·서식 resolver를 도입할 때 필요한 OC. 현재 registry-only 실행에는 필요 없습니다.
LAW_API_OC=

# 실제 폐업 절차 인터넷 조회
# 1순위: 코드 검토된 공식 출처 registry를 직접 조회합니다. 별도 검색 API 키가 필요 없습니다.
PROCEDURE_OFFICIAL_REGISTRY_ENABLED=true

# 선택 2순위: registry가 다루지 못한 질의만 Kakao Daum 웹문서 검색으로 URL을 발견합니다.
PROCEDURE_KAKAO_REST_API_KEY=
# Deprecated Kakao search key aliases. 새 배포에서는 위 전용 변수를 사용합니다.
# KAKAO_CLIENT_ID도 마지막 호환 alias로 읽지만 아래 인증 설정과 혼용하지 마세요.
PROCEDURE_SEARCH_API_KEY=

# 선택 3순위: Kakao도 공식 후보를 찾지 못한 질의의 Google Agent Search fallback입니다.
# Google Cloud에서 공개 공식기관 사이트만 포함한 app/engine을 먼저 생성해야 합니다.
# 아래 3개 값은 모두 함께 설정해야 합니다. 일부만 설정하면 구성 오류로 중단됩니다.
PROCEDURE_GOOGLE_API_KEY=
PROCEDURE_GOOGLE_PROJECT_ID=
PROCEDURE_GOOGLE_ENGINE_ID=
# 선택: global/us/eu, 비어 있으면 global
PROCEDURE_GOOGLE_LOCATION=global
PROCEDURE_SEARCH_TIMEOUT_SECONDS=8
PROCEDURE_SEARCH_TOTAL_TIMEOUT_SECONDS=60
PROCEDURE_SEARCH_MAX_RETRIES=1
PROCEDURE_SEARCH_RETRY_BACKOFF_SECONDS=0.25
PROCEDURE_SEARCH_MAX_RESPONSE_BYTES=1000000
PROCEDURE_SEARCH_MAX_REDIRECTS=3
# 선택: 기본값은 law.go.kr,easylaw.go.kr,nps.or.kr입니다.
# 코드 검토 범위 안에서만 선택할 수 있으며 더 넓은 host는 이용조건 검토 후 명시합니다.
# PROCEDURE_SEARCH_ALLOWED_DOMAINS=law.go.kr,easylaw.go.kr,nps.or.kr

# 3. 지원금
# 현재 BizInfo read-only 공고 discovery adapter가 실제로 사용하는 키입니다.
BIZINFO_API_KEY=
# 선택 보강원. 발급·승인 전이며 현재 runtime에는 아직 연결하지 않습니다.
# data.go.kr 활용신청: 15157820(기업마당), 15113968(정부24 혜택), 15125364(K-Startup)
SMES_API_TOKEN=
FOOD_SAFETY_KOREA_API_KEY=

# 4. 인프라 — DB는 MySQL + SQLAlchemy + pymysql (2026-09 BE 확정, backend/requirements.txt 참고)
# 루트 docker-compose.yml은 DB만 실행합니다: docker compose up -d db
MYSQL_ROOT_PASSWORD=devpassword
# 로컬 Python backend가 위 DB에 접속할 때의 예시 형식
# DATABASE_URL=mysql+pymysql://root:devpassword@localhost:3306/closure_agent
DATABASE_URL=
# Redis는 BE 확정 스택에 없음 — 현재 사용처 없는 선점 변수
REDIS_URL=

# 5. 인증 — 카카오 OAuth + 자체 발급 JWT (pyjwt, 2026-09 BE 확정)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback
JWT_SECRET_KEY=

# 6. Observability — Langfuse 목표 설정(현재 runtime adapter 미연결)
# 값을 넣어도 현재 코드에서는 전송하지 않습니다. 마스킹·보존 정책과 adapter 구현 후 활성화합니다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# 7. 공식 원문 수집/RAG (현재 미구현)
# 임의 URL을 환경변수로 넣어 크롤링하지 않습니다. 출처별 이용조건·robots·공공누리와
# parser/version/보존 정책을 코드 리뷰한 allowlist pipeline이 생긴 뒤 별도 변수를 정의합니다.
